{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/course/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!robots\\.txt|sitemap\\.xml|assets|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}