# Server & Database Configuration (Backend Only)
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hyperbrain
JWT_SECRET=your_jwt_secret_key_here

# AI Models - Google Gemini (Backend Only - Keep Private)
GEMINI_KEY_1=your_gemini_key_1_here
GEMINI_KEY_2=your_gemini_key_2_here
GEMINI_API_KEY=your_gemini_key_1_here

# Admin Credentials (Backend Only)
ADMIN_USERNAME=Aditya
ADMIN_PASSWORD=your_secure_password_here

# Email Delivery - Resend (Backend Only - Keep Private)
RESEND_API_KEY=your_resend_api_key_here

# Client-Side Firebase Configurations (Public in frontend/.env)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_ADMIN_USERNAME=Aditya
